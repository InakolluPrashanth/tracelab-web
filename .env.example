# Optional: override the default public Wandbox API URL.
# WANDBOX_API_URL=https://wandbox.org/api

# Enables the AI coding tutor. Keep this key on the server only.
# GEMINI_API_KEY=your-server-side-gemini-api-key
# Optional: a full generateContent URL or API base URL. Defaults to Google's Gemini API.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Optional model name.
# GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call this backend.
# FRONTEND_ORIGINS=https://tracelab-web.pages.dev,https://tracelab-free.netlify.app,https://tracelabcompiler.netlify.app
